				</div>
				<div class="col-6 col-md-5 col-lg-4 col-xl-3">
					<a href="./files/project1.pdf"><img class="img-fluid" style="border: 5px solid black;" src="images/project1-pos1.jpg" alt="images/project1-pos1.jpg"></a>
